{
  "name": "@jamez/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared engine for Jamez: game scoring engines, P2P session protocol, and transports.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@jamez/relay": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
